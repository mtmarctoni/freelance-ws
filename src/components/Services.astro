---
// Services and pricing section
---

<section id="services" class="py-20 bg-gray-50 dark:bg-gray-800 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">
        Services & Solutions
      </h2>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Comprehensive development services from modern web applications to cutting-edge 
        blockchain solutions and business automation. Start with expert consultation below.
      </p>
    </div>
    
    <!-- Main Services Overview -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      <!-- Full-Stack Web Development -->
      <div class="bg-white dark:bg-gray-900 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 p-8 border border-gray-100 dark:border-gray-700 text-center">
        <div class="w-16 h-16 bg-primary-100 dark:bg-primary-900/30 rounded-lg flex items-center justify-center mb-6 mx-auto">
          <svg class="w-8 h-8 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Full-Stack Web Development</h3>
        <p class="text-gray-600 dark:text-gray-300 mb-6">Modern web applications built with React, Next.js, TypeScript, and robust backend solutions.</p>
        <ul class="text-sm text-gray-500 dark:text-gray-400 space-y-2 mb-6 text-left">
          <li>• React/Next.js applications</li>
          <li>• TypeScript implementation</li>
          <li>• Database design & integration</li>
          <li>• API development</li>
          <li>• Authentication systems</li>
        </ul>
      </div>
      
      <!-- Web3 & Blockchain Development -->
      <div class="bg-white dark:bg-gray-900 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 p-8 border border-gray-100 dark:border-gray-700 text-center">
        <div class="w-16 h-16 bg-secondary-100 dark:bg-secondary-900/30 rounded-lg flex items-center justify-center mb-6 mx-auto">
          <svg class="w-8 h-8 text-secondary-600 dark:text-secondary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>
        </div>
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-4">Web3 & Blockchain Solutions</h3>
        <p class="text-gray-600 dark:text-gray-300 mb-6">Decentralized applications and smart contracts using Solidity, Foundry, and modern Web3 technologies.</p>
        <ul class="text-sm text-gray-500 dark:text-gray-400 space-y-2 mb-6 text-left">
          <li>• Smart contract development</li>
          <li>• DApp frontend integration</li>
          <li>• Foundry/Hardhat setup</li>
          <li>• Web3 wallet integration</li>
          <li>• Blockchain deployment</li>
        </ul>
      </div>
      
      <!-- Business Automation -->
      <div class="bg-white dark:bg-gray-900 rounded-xl shadow-lg hover:shadow-xl transition-shadow duration-300 p-8 border border-gray-100 dark:border-gray-700 text-center">
        <div class="w-16 h-16 bg-accent-100 dark:bg-accent-900/30 rounded-lg flex items-center justify-center mb-6 mx-auto">
          <svg class="w-8 h-8 text-accent-600 dark:text-accent-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
